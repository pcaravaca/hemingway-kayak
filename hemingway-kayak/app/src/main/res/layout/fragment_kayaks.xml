<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/logo_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mis kayaks"
            android:textColor="@color/logo_neon"
            android:textSize="@dimen/text_size_headline"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="Las embarcaciones que usás para pescar"
            android:textColor="@color/logo_turquoise"
            android:textSize="@dimen/text_size_body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addKayakButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_lg"
            android:backgroundTint="@color/logo_turquoise"
            android:text="Agregar un kayak"
            android:textColor="@color/logo_dark"
            app:icon="@android:drawable/ic_menu_add"
            app:iconGravity="start" />

        <LinearLayout
            android:id="@+id/kayakForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/kayakName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nombre"
                android:inputType="text"
                android:textColor="@color/white"
                android:textColorHint="#8BA3BD" />

            <Spinner
                android:id="@+id/kayakType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/kayakLength"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Largo (cm)"
                    android:inputType="numberDecimal"
                    android:textColor="@color/white"
                    android:textColorHint="#8BA3BD" />

                <EditText
                    android:id="@+id/kayakWidth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:hint="Ancho (cm)"
                    android:inputType="numberDecimal"
                    android:textColor="@color/white"
                    android:textColorHint="#8BA3BD" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/kayakWeight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Peso (kg)"
                    android:inputType="numberDecimal"
                    android:textColor="@color/white"
                    android:textColorHint="#8BA3BD" />

                <EditText
                    android:id="@+id/kayakMaxCapacity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:hint="Carga máx. (kg)"
                    android:inputType="numberDecimal"
                    android:textColor="@color/white"
                    android:textColorHint="#8BA3BD" />
            </LinearLayout>

            <Spinner
                android:id="@+id/kayakMaterial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs" />

            <Spinner
                android:id="@+id/kayakPropulsion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs" />

            <EditText
                android:id="@+id/kayakImageUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:hint="URL de la foto (opcional)"
                android:inputType="textUri"
                android:textColor="@color/white"
                android:textColorHint="#8BA3BD" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveKayakButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_md"
                android:backgroundTint="@color/logo_turquoise"
                android:text="Guardar"
                android:textColor="@color/logo_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelKayakButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="Cancelar"
                android:textColor="@color/logo_turquoise"
                app:strokeColor="@color/logo_turquoise" />
        </LinearLayout>

        <TextView
            android:id="@+id/errorView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:textColor="@color/logo_neon"
            android:textSize="@dimen/text_size_body"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="Todavía no tienes kayaks"
            android:textColor="#8BA3BD"
            android:textSize="@dimen/text_size_body"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/kayaksContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
