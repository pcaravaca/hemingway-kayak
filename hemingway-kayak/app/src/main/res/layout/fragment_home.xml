<?xml version="1.0" encoding="utf-8"?>
<ScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/logo_dark"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout 
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_lg"
        tools:context=".ui.home.HomeFragment">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/logo_neon"
            android:textSize="@dimen/text_size_display"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.15" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/fishing_favorability"
            android:textColor="@color/logo_turquoise"
            android:textSize="@dimen/text_size_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/weatherButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_xl"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginEnd="@dimen/spacing_xl"
            android:backgroundTint="@color/logo_turquoise"
            android:text="@string/weather_title"
            android:textColor="@color/logo_dark"
            android:textSize="@dimen/text_size_subtitle"
            app:icon="@android:drawable/ic_menu_compass"
            app:iconGravity="start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subtitleText"
            app:layout_constraintWidth_max="400dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fishingButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_xl"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_xl"
            android:backgroundTint="@color/logo_neon"
            android:text="@string/fishing_title"
            android:textColor="@color/logo_dark"
            android:textSize="@dimen/text_size_subtitle"
            app:icon="@android:drawable/ic_menu_send"
            app:iconGravity="start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/weatherButton"
            app:layout_constraintWidth_max="400dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mapButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_xl"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_xl"
            android:backgroundTint="@color/white"
            android:text="@string/map_title"
            android:textColor="@color/logo_dark"
            android:textSize="@dimen/text_size_subtitle"
            app:icon="@android:drawable/ic_menu_mapmode"
            app:iconGravity="start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fishingButton"
            app:layout_constraintWidth_max="400dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_xl"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_xl"
            android:text="@string/settings_title"
            android:textColor="@color/logo_turquoise"
            android:textSize="@dimen/text_size_subtitle"
            app:icon="@android:drawable/ic_menu_preferences"
            app:iconGravity="start"
            app:iconTint="@color/logo_turquoise"
            app:strokeColor="@color/logo_turquoise"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mapButton"
            app:layout_constraintWidth_max="400dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
