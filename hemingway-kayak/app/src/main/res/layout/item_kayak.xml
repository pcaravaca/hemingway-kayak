<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_sm"
    android:background="@color/logo_dark"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md">

    <TextView
        android:id="@+id/kayakName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/logo_neon"
        android:textSize="@dimen/text_size_subtitle"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/kayakSpecs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:textColor="@color/logo_turquoise"
        android:textSize="@dimen/text_size_body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editKayakButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:layout_weight="1"
            android:text="Editar"
            android:textColor="@color/logo_turquoise"
            app:strokeColor="@color/logo_turquoise" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteKayakButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_weight="1"
            android:text="Eliminar"
            android:textColor="@color/logo_neon"
            app:strokeColor="@color/logo_neon" />
    </LinearLayout>
</LinearLayout>
