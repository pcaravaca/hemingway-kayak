<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.hemingway.kayak.ui.auth.LoginFragment"
        android:label="@string/login_title"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.hemingway.kayak.ui.auth.RegisterFragment"
        android:label="@string/register_title"
        tools:layout="@layout/fragment_register" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.hemingway.kayak.ui.home.HomeFragment"
        android:label="@string/home_title"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_weather"
            app:destination="@id/weatherFragment" />
        <action
            android:id="@+id/action_home_to_fishing"
            app:destination="@id/fishingFragment" />
        <action
            android:id="@+id/action_home_to_map"
            app:destination="@id/mapFragment" />
        <action
            android:id="@+id/action_home_to_spots"
            app:destination="@id/spotsFragment" />
        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/weatherFragment"
        android:name="com.hemingway.kayak.ui.weather.WeatherFragment"
        android:label="@string/weather_title"
        tools:layout="@layout/fragment_weather">
        <argument
            android:name="latitude"
            app:argType="float"
            android:defaultValue="0.0" />
        <argument
            android:name="longitude"
            app:argType="float"
            android:defaultValue="0.0" />
    </fragment>

    <fragment
        android:id="@+id/fishingFragment"
        android:name="com.hemingway.kayak.ui.fishing.FishingFragment"
        android:label="@string/fishing_title"
        tools:layout="@layout/fragment_fishing">
        <argument
            android:name="latitude"
            app:argType="float"
            android:defaultValue="0.0" />
        <argument
            android:name="longitude"
            app:argType="float"
            android:defaultValue="0.0" />
    </fragment>

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.hemingway.kayak.ui.map.MapFragment"
        android:label="@string/map_title"
        tools:layout="@layout/fragment_map" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.hemingway.kayak.ui.settings.SettingsFragment"
        android:label="@string/settings_title"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/tournamentsFragment"
        android:name="com.hemingway.kayak.ui.tournaments.TournamentsFragment"
        android:label="@string/tournaments_title"
        tools:layout="@layout/fragment_tournaments">
        <action
            android:id="@+id/action_tournaments_to_detail"
            app:destination="@id/tournamentDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/tournamentDetailFragment"
        android:name="com.hemingway.kayak.ui.tournaments.TournamentDetailFragment"
        android:label="@string/tournaments_title"
        tools:layout="@layout/fragment_tournament_detail">
        <argument
            android:name="id"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.hemingway.kayak.ui.history.HistoryFragment"
        android:label="@string/history_title"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/trackingFragment"
        android:name="com.hemingway.kayak.ui.tracking.TrackingFragment"
        android:label="@string/tracking_title"
        tools:layout="@layout/fragment_tracking" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.hemingway.kayak.ui.profile.ProfileFragment"
        android:label="@string/profile_title"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/spotsFragment"
        android:name="com.hemingway.kayak.ui.spots.SpotsFragment"
        android:label="Spots"
        tools:layout="@layout/fragment_spots" />

</navigation>
